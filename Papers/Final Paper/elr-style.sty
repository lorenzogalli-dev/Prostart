\newif\ifELRanonymous
\ELRanonymousfalse
\newcommand{\ELRAnonymousOn}{\ELRanonymoustrue}
\newcommand{\ELRAnonymousOff}{\ELRanonymousfalse}

%% =====================================================================
%% BRANDING / LABELS
%% =====================================================================
% The "abstract" panel is now labelled "Topic" and no longer prints keywords.
\newcommand{\ELRAbstractLabel}{Abstract}

% Topic panel: editorial box, square corners, subtle background.
\newtcolorbox{ELRAbstractBox}{
  enhanced,
  colback=ELRBlueMist,
  colframe=ELRBlueMist,
  boxrule=0pt,
  arc=0pt,
  left=9pt,right=9pt,top=7pt,bottom=7pt,
  borderline west={1.6pt}{0pt}{ELRGold},
  before skip=0pt,
  after skip=0pt
}

\forestset{
  elrtree/.style={
    for tree={
      align=center,
      inner sep=1.5pt,
      l sep=9mm,
      s sep=4mm,
      edge={draw=ELRBlue,line width=0.45pt},
      font=\small
    }
  },
  elrhighlight/.style={
    tikz+={\fill[ELRGold] (.south) circle[radius=1.1pt];}
  }
}

%% ---------------------------------------------------------------------
%% Hyperlinks (after colours exist)
%% ---------------------------------------------------------------------
\RequirePackage[colorlinks=true,
  linkcolor=ELRDeepBlue,
  citecolor=ELRDeepBlue,
  urlcolor=ELRBlue]{hyperref}
\urlstyle{same}

%% =====================================================================
%% RUNNING HEADER -- simplified: article title on the left, page number
%% only on the right. No badge, no year/issue, no footer.
%% =====================================================================
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{%
  \sffamily\footnotesize\color{ELRBlue}%
  \ELR@title%
}
\fancyhead[R]{%
  \sffamily\footnotesize\bfseries\color{ELRDeepBlue}%
  \thepage%
}
\renewcommand{\headrulewidth}{0.34pt}
\renewcommand{\headrule}{%
  \hbox to\headwidth{%
    \color{ELRLightGold}%
    \leaders\hrule height \headrulewidth\hfill
  }%
}
\renewcommand{\footrulewidth}{0pt}

\fancypagestyle{firstpage}{%
  \fancyhf{}%
  \renewcommand{\headrulewidth}{0pt}%
  \renewcommand{\footrulewidth}{0pt}%
}

%% =====================================================================
%% FRONT MATTER -- masthead / citation block and keywords removed.
%% Layout: title + author + affiliation + email, Topic panel (no logo, no rule).
%% =====================================================================
\newcommand{\ELRMakeTitle}{%
  \setcounter{page}{\ELR@startpage}%
  \thispagestyle{firstpage}%
  % Page 1 has no running header, but its space (headheight + headsep) is still
  % reserved: take it back so the title starts at the header's height.
  \vspace*{\dimexpr-\headheight-\headsep\relax}%

  % --- Article title ---
  \begin{center}
    {\fontsize{15}{34}\selectfont\bfseries\color{ELRDeepBlue}\ELR@title}\par
    \vspace{0.68em}
    \ifELRanonymous
      {\sffamily\normalsize\bfseries\color{ELRBlue}Anonymous Author}\par
    \else
      \ifdefstring{\ELR@series}{ELR}{%
        {\sffamily\fontsize{10.8}{13}\selectfont\bfseries\color{ELRRegularCyanDark}\ELR@author}\par
      }{%
        {\sffamily\fontsize{10.8}{13}\selectfont\bfseries\color{ELRSpecialPurpleDark}\ELR@author}\par
      }
      \vspace{0.08em}
      {\fontsize{9.4}{11.2}\selectfont\color{ELRMuted}\ELR@affiliation}\par
      \vspace{0.04em}
      {\fontsize{8.2}{9.8}\selectfont\color{ELRSoft}\texttt{\ELR@email}}\par
    \fi
  \end{center}

  \vspace{0.50em}

  % --- Topic panel (formerly "Abstract"); no keywords line ---
  \begin{ELRAbstractBox}
    \noindent
    {\sffamily\fontsize{9}{11}\selectfont\bfseries\ELRAccentText{\ELRAbstractLabel}}
    \hspace{0.55em}{\color{ELRGold}\rule{1.55cm}{0.65pt}}\par
    \vspace{0.36em}
    {\fontsize{9.6}{12.2}\selectfont\setlength{\parindent}{0pt}\color{ELRText}\ELR@abstract\par}
  \end{ELRAbstractBox}
  \vspace{1em}

}
