%% =====================================================================
%% Explorations in Linguistic Review (ELR)
%% Author Style -- Linguistic Horizon Edition v1.0 (simplified)
%% Layout dimensions follow the Glossa A4 text block:
%% 150 mm text width, 237 mm text height.
%% Authors should edit main.tex only.
%% Compile with XeLaTeX or LuaLaTeX.
%% =====================================================================

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{elr-style}[2026/08/23 v10.1 ELR Linguistic Horizon style (simplified)]

%% ---------------------------------------------------------------------
%% Engine and fonts
%% ---------------------------------------------------------------------
\RequirePackage{iftex}
\ifPDFTeX
  \PackageError{elr-style}{pdfLaTeX is not supported}{Use XeLaTeX or LuaLaTeX.}
\fi
\RequirePackage{etoolbox}
\RequirePackage{fontspec}
\IfFileExists{xeCJK.sty}{%
  \ifXeTeX
    \RequirePackage{xeCJK}
    \IfFontExistsTF{Noto Serif CJK SC}{%
      \setCJKmainfont{Noto Serif CJK SC}[BoldFont=Noto Serif CJK SC Bold]%
    }{%
      \IfFontExistsTF{FandolSong-Regular}{\setCJKmainfont{FandolSong-Regular}}{}%
    }
    \IfFontExistsTF{Noto Sans CJK SC}{%
      \setCJKsansfont{Noto Sans CJK SC}[BoldFont=Noto Sans CJK SC Bold]%
    }{%
      \IfFontExistsTF{FandolHei-Regular}{\setCJKsansfont{FandolHei-Regular}}{}%
    }
  \fi
}{}

% Charis SIL is particularly suitable for linguistics and IPA.
% Portable fallbacks are provided for Overleaf installations.
\IfFontExistsTF{Charis SIL}{%
  \setmainfont{Charis SIL}[Ligatures=TeX]%
}{%
  \IfFontExistsTF{Times New Roman}{%
    \setmainfont{Times New Roman}[Ligatures=TeX]%
  }{%
    \setmainfont{TeX Gyre Termes}[Ligatures=TeX]%
  }%
}

\IfFontExistsTF{Fira Sans}{%
  \setsansfont{Fira Sans}[Scale=0.95]%
}{%
  \setsansfont{TeX Gyre Heros}[Scale=0.94]%
}

%% ---------------------------------------------------------------------
%% Packages
%% ---------------------------------------------------------------------
\RequirePackage{microtype}
\RequirePackage{graphicx}
\RequirePackage{xcolor}
\RequirePackage{setspace}
\RequirePackage{titlesec}
\RequirePackage{fancyhdr}
\RequirePackage[most]{tcolorbox}
\RequirePackage{tikz}
\RequirePackage{booktabs}
\RequirePackage{array}
\RequirePackage{caption}
\IfFileExists{linguex.sty}{\RequirePackage{linguex}}{}
\RequirePackage[linguistics]{forest}
\RequirePackage{xparse}
\RequirePackage{etoolbox}

%% =====================================================================
%% PAGE DIMENSIONS -- GLOSSA-BASED A4 TEXT BLOCK
%% =====================================================================
\setlength{\paperheight}{297mm}
\setlength{\paperwidth}{210mm}
\setlength{\textwidth}{150mm}
\setlength{\textheight}{237mm}
\setlength{\oddsidemargin}{0.46cm}
\setlength{\evensidemargin}{0.46cm}
\setlength{\topmargin}{-13mm}
\setlength{\headheight}{8.6mm}
\setlength{\headsep}{14.0mm}
\setlength{\footskip}{0.46cm}
\setlength{\parskip}{0pt}
\setlength{\parindent}{0.1in}
\raggedbottom

%% =====================================================================
%% ELR LINGUISTIC HORIZON PALETTE / 语言探索色
%% =====================================================================
\definecolor{ELRInk}{HTML}{1F242A}
\definecolor{ELRText}{HTML}{30363D}
\definecolor{ELRMuted}{HTML}{68717A}
\definecolor{ELRSoft}{HTML}{8A929B}

\definecolor{ELRBlue}{HTML}{163A63}
\definecolor{ELRDeepBlue}{HTML}{102A47}
\definecolor{ELRGold}{HTML}{B7924A}
\definecolor{ELRLightGold}{HTML}{D7C18A}
\definecolor{ELRPaleGold}{HTML}{EFE6D2}

% Issue-family accent colours.
% ELR regular issues use cyan/teal; special issues use purple.
\definecolor{ELRRegularCyan}{HTML}{1AA79F}
\definecolor{ELRRegularCyanDark}{HTML}{137B76}
\definecolor{ELRSpecialPurple}{HTML}{8A4FD1}
\definecolor{ELRSpecialPurpleDark}{HTML}{6838A2}

\definecolor{ELRLine}{HTML}{DDE3E8}
\definecolor{ELRBlueMist}{HTML}{F6F8FA}
\definecolor{ELRWarmWhite}{HTML}{FCFBF8}
\definecolor{ELRFrameSoft}{HTML}{E8EDF1}

\color{ELRText}

%% ---------------------------------------------------------------------
%% Typography
%% ---------------------------------------------------------------------
\setstretch{1.12}
\emergencystretch=1em
\clubpenalty=10000
\widowpenalty=10000

% Modern sans headings; gold numbers, blue titles.
\newcommand{\ELRAccentText}[1]{%
  \ifdefstring{\ELR@series}{ELR}{\color{ELRRegularCyanDark}#1}{\color{ELRSpecialPurpleDark}#1}%
}

\titleformat{\section}
  {\sffamily\fontsize{15.2}{18.2}\selectfont\bfseries\color{ELRBlue}}
  {\ELRAccentText{\thesection}}
  {0.72em}{}
\titlespacing*{\section}{0pt}{1.55em}{0.58em}

\titleformat{\subsection}
  {\sffamily\fontsize{12.4}{14.8}\selectfont\bfseries\color{ELRDeepBlue}}
  {\ELRAccentText{\thesubsection}}
  {0.68em}{}
\titlespacing*{\subsection}{0pt}{1.15em}{0.42em}

\titleformat{\subsubsection}
  {\sffamily\normalsize\bfseries\color{ELRMuted}}
  {\ELRAccentText{\thesubsubsection}}
  {0.62em}{}
\titlespacing*{\subsubsection}{0pt}{0.95em}{0.32em}

\captionsetup{
  font=small,
  labelfont={bf,color=ELRBlue},
  textfont={color=ELRText},
  labelsep=period,
  skip=5pt
}

%% ---------------------------------------------------------------------
%% Footnotes / footers -- disabled by default, with a subtle gold rule
%% ---------------------------------------------------------------------
% Automatic page-footer decoration (publication notice, history box) has
% been removed. Manual \footnote{} calls still work and use a thin gold
% separator consistent with the template palette.
\renewcommand{\footrulewidth}{0pt}
\renewcommand{\footnoterule}{%
  \kern -3pt
  {\color{ELRGold}\hrule width 0.30\textwidth height 0.45pt}%
  \kern 3.4pt
}

